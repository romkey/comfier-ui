# Copy to .env and fill in. Never commit .env.

# Public URL of this app (used to build the Authentik redirect URI)
APP_URL=http://localhost:3000
# Hostname allowed by Rails host authorization (production), e.g. comfier.example.com
APP_HOST=

# Authentik OpenID Connect provider
# Issuer is shown on the provider page in Authentik, e.g. https://auth.example.com/application/o/comfier-ui/
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Members of this Authentik group are admins
AUTHENTIK_ADMIN_GROUP=comfier-admins

# Development only: an email/password sign-in that needs no Authentik.
# Stays off until both DEV_LOGIN_EMAIL and DEV_LOGIN_PASSWORD are set.
DEV_LOGIN=false
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
DEV_LOGIN_NAME=Developer
# Set to false to see the app as a regular (non-admin) user
DEV_LOGIN_ADMIN=true

# PostgreSQL — used by config/database.yml and the bundled Postgres in docker compose
# Compose stacks override POSTGRES_HOST to the `postgres` service; use `localhost` when Rails runs on the host
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=comfier_ui_development
POSTGRES_DATABASE_TEST=comfier_ui_test
POSTGRES_DATABASE_PRODUCTION=comfier_ui_production
# Host port when the dev stack publishes Postgres (docker-compose.dev.yml)
POSTGRES_HOST_PORT=5432

# Production secrets — generate with `bin/rails secret` and `bin/rails db:encryption:init`
SECRET_KEY_BASE=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Development only: your LAN DNS server, if ComfyUI hosts have private names (e.g. gpu-box.lan)
# that the dev containers can't resolve. Docker Desktop doesn't forward those to your LAN DNS.
# DEV_DNS=192.168.1.1

# Redis — web and sidekiq must use the same URL (compose default: redis://redis:6379/0).
# REDIS_URL=redis://redis:6379/0

# Notifications. Users choose email and/or Slack; addresses and Slack IDs come from Authentik.
# Email is unavailable until SMTP_ADDRESS is set.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS=true
# SMTP_DOMAIN=
MAIL_FROM=Comfier <comfier@example.com>
# Slack bot token (xoxb-...) with chat:write, im:write and files:write. Slack is unavailable until it's set.
SLACK_BOT_TOKEN=
# Default max attachment size (MB) when the database is first created. Admins can change these under Settings → Notifications.
# NOTIFICATION_ATTACHMENT_MAX_MB=20
# NOTIFICATION_EMAIL_ATTACHMENT_MAX_MB=0.488
# NOTIFICATION_SLACK_ATTACHMENT_MAX_MB=5

# Workflow assistant (LiteLLM). Used when admins choose Suggest placeholders on a workflow.
LITELLM_URL=
LITELLM_API_KEY=
LITELLM_MODEL=
# LITELLM_TIMEOUT_SECONDS=180

# Optional
# TIME_ZONE=America/Los_Angeles
# GENERATION_TIMEOUT_MINUTES=60
# MODEL_DOWNLOAD_TIMEOUT_HOURS=12
# SIDEKIQ_CONCURRENCY=5
# FORCE_SSL=true
# ASSUME_SSL=true
