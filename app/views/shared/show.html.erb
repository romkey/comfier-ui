<% content_for :title, @generation.title %>

<div class="text-12 text-secondary mb-2">
  <%= link_to 'Shared', shared_index_path, class: 'link-secondary' %> /
  <%= @generation.kind_info.label %>
</div>

<div class="d-flex align-items-start justify-content-between gap-3 mb-3">
  <div class="min-w-0">
    <h1 class="h-page-title mb-1 text-truncate"><%= @generation.title %></h1>
    <div class="text-13 text-secondary">
      Shared by <%= @generation.user.display_name %> · <%= @generation.style_name %> · <%= friendly_time(@generation.shared_at) %>
    </div>
  </div>
  <div class="d-flex gap-2">
    <% if @generation.share_prompt? && @generation.prompt.present? %>
      <%= link_to "Try this prompt", "#{@generation.kind_info.path}?from=#{@generation.id}",
                  class: 'btn btn-outline-secondary btn-sm' %>
    <% end %>
    <% if current_user.admin? %>
      <div class="dropdown">
        <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="dropdown" aria-label="More">
          <i class="bi bi-three-dots" aria-hidden="true"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end text-13">
          <li>
            <%= button_to 'Remove share', unshare_shared_path(@generation), method: :delete,
                                                                           class: 'dropdown-item text-danger' %>
          </li>
        </ul>
      </div>
    <% end %>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <% @generation.outputs.each do |output| %>
      <figure class="output-full mb-3">
        <%= output_preview(output, controls: true) %>
      </figure>
    <% end %>
  </div>
  <div class="col-lg-4">
    <div class="sidebar-card">
      <% if @generation.share_prompt? && @generation.prompt.present? %>
        <div class="h-section-label">Prompt</div>
        <p class="text-13 mb-3 text-break"><%= @generation.prompt %></p>
      <% end %>
      <% if @generation.share_input? && @generation.input_image.attached? %>
        <div class="h-section-label">Reference</div>
        <%= image_tag rails_blob_path(@generation.input_image, disposition: 'inline'), class: 'output-media mb-3',
                                                                                       alt: 'Reference image' %>
      <% end %>
      <div class="h-section-label">Style</div>
      <p class="text-13 mb-0"><%= @generation.style_name %></p>
    </div>
  </div>
</div>
