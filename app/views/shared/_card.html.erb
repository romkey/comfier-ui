<%= tag.article class: 'result-card' do %>
  <div class="result-media">
    <%= result_media_preview(generation) %>
  </div>
  <div class="result-meta">
    <%= link_to generation.title, shared_path(generation), class: 'stretched-link text-13 text-body text-truncate d-block' %>
    <div class="d-flex align-items-center justify-content-between text-12 text-secondary mt-1">
      <span><%= generation.user.display_name %> · <%= generation.style_name %></span>
      <%= friendly_time(generation.shared_at) %>
    </div>
  </div>
<% end %>
