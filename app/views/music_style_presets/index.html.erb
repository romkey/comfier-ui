<% content_for :title, 'Music style presets' %>
<h1 class="h-page-title mb-3">Music style presets</h1>
<p class="text-secondary">Save musical styles to reuse across songs. These presets are private to your account.</p>
<div class="d-flex flex-wrap gap-2 mb-4">
  <%= link_to 'New preset', new_music_style_preset_path, class: 'btn btn-primary' %>
</div>
<% if @presets.empty? %>
  <p class="text-secondary">No music style presets yet. Create one to get started.</p>
<% end %>
<% @presets.each do |preset| %>
  <div class="card card-body mb-3">
    <h2 class="h5"><%= preset.name %></h2>
    <div class="mb-3"><%= simple_format(preset.description) %></div>
    <div class="d-flex gap-2">
      <%= link_to 'Edit', edit_music_style_preset_path(preset), class: 'btn btn-outline-secondary btn-sm' %>
      <%= button_to 'Delete', music_style_preset_path(preset), method: :delete, class: 'btn btn-outline-danger btn-sm',
                    data: { turbo_confirm: 'Delete this music style preset? Existing songs will keep their style.' } %>
    </div>
  </div>
<% end %>
<% if @pagy.last > 1 %>
  <nav class="mt-3 d-flex justify-content-center" aria-label="Pages"><%== @pagy.series_nav(:bootstrap) %></nav>
<% end %>
