<%= form_with model: @preset, class: 'card card-body' do |f| %>
  <% if @preset.errors.any? %>
    <div class="alert alert-danger" role="alert"><%= @preset.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="mb-3">
    <%= f.label :name, class: 'form-label' %>
    <%= f.text_field :name, class: 'form-control', required: true, maxlength: 100 %>
  </div>
  <div class="mb-3">
    <%= f.label :description, 'Music style', class: 'form-label' %>
    <%= f.text_area :description, class: 'form-control', rows: 6, required: true, maxlength: 5000,
                                 placeholder: 'Warm acoustic folk, fingerpicked guitar, intimate vocals, light percussion…' %>
    <div class="form-text">Describe genre, mood, instruments, vocals, tempo, or production. Enter lyrics separately when generating a song.</div>
  </div>
  <div class="d-flex gap-2">
    <%= f.submit 'Save preset', class: 'btn btn-primary' %>
    <%= link_to 'Cancel', music_style_presets_path, class: 'btn btn-outline-secondary' %>
  </div>
<% end %>
