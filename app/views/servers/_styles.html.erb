<div class="d-flex align-items-end justify-content-between mt-4 mb-2">
  <div>
    <div class="h-section-label mb-0">Workflows</div>
    <% if local_assigns[:rescan_requested] %>
      <div class="text-12 text-secondary mt-1">Re-scanning <%= backend.name %>… this table updates when it reports back.</div>
    <% end %>
  </div>
  <% if can_manage %>
    <div class="d-flex gap-2">
      <%= button_to 'Re-scan', rescan_server_styles_path(backend), class: 'btn btn-outline-secondary btn-sm',
                    form: { data: { turbo_frame: "server_styles_#{backend.id}" } } %>
      <% all_missing = backend.downloadable_missing_models.size + backend.downloadable_engine_models.size %>
      <% if all_missing.positive? %>
        <%= button_to "Download all (#{all_missing})", server_downloads_path(backend),
                      params: { all: true }, class: 'btn btn-outline-secondary btn-sm' %>
      <% end %>
    </div>
  <% end %>
</div>
<% by_kind = workflows.group_by(&:kind) %>
<% GenerationKind.all.each do |kind| %>
  <% kind_workflows = Array(by_kind[kind.key]).sort_by { |w| w.name.downcase } %>
  <% next if kind_workflows.empty? %>
  <div class="text-13 fw-semibold text-secondary mt-3 mb-1"><%= kind.label %></div>
  <table class="table table-compact align-middle">
  <tbody>
    <% kind_workflows.each do |workflow| %>
      <% record = availability[workflow.id] %>
      <% off = backend.workflow_disabled?(workflow) %>
      <tr id="<%= dom_id(workflow, :server_style) %>" class="<%= 'style-off' if off %>">
        <td><%= workflow.name %></td>
        <td>
          <% if off %>
            <span class="badge text-bg-secondary fw-medium" title="Disabled on this server">Off</span>
          <% else %>
            <%= availability_cell(record) %>
          <% end %>
        </td>
        <td class="text-12 text-secondary">
          <% if off %>
            Jobs for this workflow won't run here.
          <% else %>
            <%= Array(record&.details&.dig('reasons')).first %>
            <% Array(record&.details&.dig('hints')).each do |hint| %><div class="text-warning"><%= hint %></div><% end %>
          <% end %>
        </td>
        <td class="text-end text-nowrap">
          <% if can_manage %>
            <div class="d-inline-flex gap-2 align-items-center">
              <%# Engine styles stay ready without their model (it downloads on the first run) but offer it. %>
              <% if !off && (record&.needs_downloads? || (record&.ready? && record.details['models'].present?)) %>
                <%= button_to 'Download', server_downloads_path(backend, workflow_id: workflow.id),
                              class: 'btn btn-outline-secondary btn-sm' %>
              <% end %>
              <%= button_to off ? 'Enable' : 'Disable', server_styles_path(backend), method: :patch,
                            params: { workflow_id: workflow.id, enabled: off ? '1' : '0' },
                            class: 'btn btn-outline-secondary btn-sm',
                            aria: { label: "#{off ? 'Enable' : 'Disable'} #{workflow.name} on #{backend.name}" } %>
            </div>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
  </table>
<% end %>
