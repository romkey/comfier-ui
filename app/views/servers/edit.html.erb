<% content_for :title, "#{@backend.name} settings" %>

<div class="small text-secondary mb-2">
  <%= link_to 'Servers', servers_path, class: 'link-secondary' %> ·
  <%= link_to @backend.name, server_path(@backend), class: 'link-secondary' %>
</div>
<div class="d-flex align-items-end justify-content-between mb-3">
  <h1 class="h-page-title mb-0"><%= @backend.name %> settings</h1>
  <%= button_to 'Delete server', server_path(@backend), method: :delete, class: 'btn btn-outline-danger btn-sm',
                form: { data: { turbo_confirm: "Delete #{@backend.name}? Its key stops working and waiting jobs move to other servers." } } %>
</div>

<div style="max-width: 40rem">
  <%= render 'form', backend: @backend %>
</div>
