<%= tag.article id: dom_id(generation), class: ['result-card', "result-#{generation_result_status(generation)}"] do %>
  <% output = primary_result_output(generation) %>
  <div class="result-media">
    <%= result_media_preview(generation) %>
    <% if output && generation.outputs.size > 1 %>
      <span class="result-count text-11">+<%= generation.outputs.size - 1 %></span>
    <% end %>
    <%= generation_shared_indicator(generation) %>
  </div>
  <div class="result-meta">
    <%= link_to generation.title, generation_path(generation), class: 'stretched-link text-13 text-body text-truncate d-block',
                                                                title: generation.prompt %>
    <div class="d-flex align-items-center justify-content-between text-12 text-secondary mt-1">
      <span class="d-flex align-items-center gap-2 min-w-0">
        <%= generation_status(generation) %>
        <span class="text-truncate"><%= generation.style_name %></span>
      </span>
      <%= friendly_time(generation.created_at) %>
    </div>
    <% if generation.agent_job? && generation.in_progress? %>
      <div class="text-12 text-secondary text-truncate mt-1"><%= agent_progress_line(generation) %></div>
    <% end %>
  </div>
<% end %>
