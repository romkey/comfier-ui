<% sync_on = %w[loadedmetadata durationchange timeupdate play pause ended volumechange ratechange] %>
<div class="audio-player" data-controller="audio-player" data-turbo-permanent
     data-audio-player-waveform-url-value="<%= waveform_url %>">
  <%= audio_tag url, controls: true, preload: 'metadata', class: 'w-100',
                data: { audio_player_target: 'audio',
                        action: [*sync_on.map { "#{it}->audio-player#sync" },
                                 'error->audio-player#unavailable'].join(' ') } %>
  <div class="audio-player-interface" data-audio-player-target="interface" hidden>
    <div class="audio-player-waveform">
      <div class="audio-player-wave" data-audio-player-target="waveform" aria-hidden="true"></div>
      <input type="range" min="0" max="100" step="0.1" value="0" aria-label="Seek through audio"
             class="audio-player-seek" data-audio-player-target="seek" data-action="input->audio-player#seek">
    </div>
    <div class="audio-player-ticks text-11 text-secondary num" aria-hidden="true">
      <% 5.times do %><span data-audio-player-target="tick">0:00</span><% end %>
    </div>
    <div class="audio-player-controls mt-3">
      <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-primary btn-sm" data-action="audio-player#toggle"
                data-audio-player-target="play" aria-label="Play audio">
          <i class="bi bi-play me-1" aria-hidden="true" data-audio-player-target="icon"></i><span data-audio-player-target="playLabel">Play</span>
        </button>
        <span class="text-12 text-secondary num text-nowrap">
          <span class="text-body" data-audio-player-target="current">0:00</span> / <span data-audio-player-target="duration">0:00</span>
        </span>
      </div>
      <div class="d-flex align-items-center gap-2">
        <label class="d-flex align-items-center gap-2 text-12 text-secondary">
          Speed
          <select class="form-select form-select-sm audio-player-speed" aria-label="Playback speed"
                  data-audio-player-target="speed" data-action="audio-player#speed">
            <% [0.75, 1, 1.25, 1.5, 2].each do |rate| %>
              <option value="<%= rate %>" <%= 'selected' if rate == 1 %>><%= rate %>×</option>
            <% end %>
          </select>
        </label>
        <button type="button" class="btn btn-outline-secondary btn-sm" aria-pressed="false"
                data-audio-player-target="mute" data-action="audio-player#mute">Mute</button>
      </div>
    </div>
  </div>
  <div class="text-12 text-secondary mt-1" role="status" data-audio-player-target="notice">Loading waveform…</div>
</div>
