<%= turbo_stream.replace dom_id(@generation, :sharing_sidebar) do %>
  <%= render 'generations/sharing_sidebar', generation: @generation, live: @generation.succeeded? %>
<% end %>

<%= turbo_stream.replace dom_id(@generation, :sharing_badges) do %>
  <% if @generation.shared? %>
    <span class="badge text-bg-success-subtle">Shared</span>
  <% end %>
  <% if @generation.publicly_linked? %>
    <span class="badge text-bg-primary-subtle">Public link</span>
  <% end %>
<% end %>
