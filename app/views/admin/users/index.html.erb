<% content_for :title, 'Users' %>

<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0">Users</h1>
    <div class="text-13 text-secondary mt-1">
      <span class="text-body num"><%= @pagy.count %></span> total
      <% if @admin_count.positive? %> · <span class="text-body num"><%= @admin_count %></span> admin<% end %>
    </div>
  </div>
</div>

<% if @users.empty? %>
  <div class="status-panel status-clear">
    <p class="text-13 text-secondary mb-0">No one has signed in yet.</p>
  </div>
<% else %>
  <table class="table table-compact table-hover align-middle">
    <thead>
      <tr>
        <th><%= users_sort_link 'User', 'user', default: 'asc' %></th>
        <th><%= users_sort_link 'Last login', 'last_login' %></th>
        <th><%= users_sort_link 'Joined', 'joined' %></th>
        <th class="w-status"><%= users_sort_link 'Role', 'role' %></th>
        <th class="text-end"><%= users_sort_link 'Generations', 'generations' %></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <% generations = @generation_counts[user.id] || 0 %>
        <tr>
          <td>
            <div class="fw-medium"><%= user.display_name %></div>
            <div class="text-12 text-secondary"><%= user.email.presence || user.username.presence || '—' %></div>
          </td>
          <td class="text-12 text-secondary">
            <%= friendly_time(user.last_signed_in_at) || tag.span('Never', class: 'text-secondary') %>
          </td>
          <td class="text-12 text-secondary"><%= friendly_time(user.created_at) %></td>
          <td>
            <% if user.admin? %>
              <span class="badge text-bg-primary-subtle text-11">Admin</span>
            <% else %>
              <span class="status-dot status-muted" title="Member" aria-label="Member"></span>
            <% end %>
          </td>
          <td class="text-end num <%= 'text-secondary' if generations.zero? %>">
            <span class="<%= 'fw-medium' if generations.positive? %>"><%= generations %></span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @pagy.last > 1 %>
    <nav class="mt-3 d-flex justify-content-center" aria-label="Pages"><%== @pagy.series_nav(:bootstrap) %></nav>
  <% end %>
<% end %>
