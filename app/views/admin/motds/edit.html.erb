<% content_for :title, 'Message of the day' %>

<h1 class="h-page-title mb-3">Message of the day</h1>
<p class="text-13 text-secondary mb-3">
  Shown in a banner at the top of every page. People can dismiss it; changing the text shows it to everyone again.
  Leave it blank to remove the banner.
</p>

<%= form_with model: @settings, url: admin_motd_path, method: :patch, class: 'settings-form-wide' do |f| %>
  <% if @settings.errors.any? %>
    <div class="alert alert-danger py-2 text-13"><%= @settings.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="mb-3">
    <%= f.label :motd_text, 'Message', class: 'form-label' %>
    <%= f.text_area :motd_text, rows: 4, maxlength: 1000, class: 'form-control form-control-sm' %>
    <div class="form-text text-12">Plain text, up to 1,000 characters.</div>
  </div>

  <%= f.submit 'Save', class: 'btn btn-primary btn-sm' %>
<% end %>
