<% content_for :title, 'Reports' %>

<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0">Reports</h1>
    <div class="text-13 text-secondary mt-1">
      <span class="text-body num"><%= @open_count %></span> open
    </div>
  </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
  <%= link_to 'Open', admin_reports_path, class: ['filter-chip', { active: @status == 'open', warning: @open_count.positive? }] %>
  <%= link_to 'Reviewed', admin_reports_path(status: 'reviewed'), class: ['filter-chip', { active: @status == 'reviewed' }] %>
  <%= link_to 'All', admin_reports_path(status: 'all'), class: ['filter-chip', { active: params[:status] == 'all' }] %>
</div>

<% if @report_cases.empty? %>
  <div class="status-panel status-clear">
    <p class="text-13 text-secondary mb-0">No reports yet.</p>
  </div>
<% else %>
  <table class="table table-compact table-hover align-middle">
    <thead>
      <tr>
        <th>Result</th>
        <th>Owner</th>
        <th class="text-end num">Reports</th>
        <th>Latest</th>
        <th>First reported</th>
        <th class="w-status">Status</th>
      </tr>
    </thead>
    <tbody>
      <% @report_cases.each do |report_case| %>
        <% latest = report_case.latest_report %>
        <tr class="row-link" data-controller="row-link" data-row-link-href-value="<%= admin_report_path(report_case) %>">
          <td>
            <%= link_to report_case.display_title, admin_report_path(report_case), class: 'text-body fw-medium' %>
            <% if report_case.generation.nil? %>
              <div class="text-12 text-secondary">Deleted result</div>
            <% elsif report_case.generation.hidden_for_review? %>
              <span class="badge text-bg-warning-subtle text-11">Hidden</span>
            <% end %>
          </td>
          <td class="text-12"><%= report_case.owner.display_name %></td>
          <td class="text-end num"><%= report_case.reports_count %></td>
          <td class="text-12 text-secondary"><%= latest&.category_label || '—' %></td>
          <td class="text-12 text-secondary"><%= friendly_time(report_case.created_at) %></td>
          <td><%= report_case_status(report_case) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @pagy.last > 1 %>
    <nav class="mt-3 d-flex justify-content-center" aria-label="Pages"><%== @pagy.series_nav(:bootstrap) %></nav>
  <% end %>
<% end %>
