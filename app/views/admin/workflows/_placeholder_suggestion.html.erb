<div id="workflow_placeholder_panel">
  <% if local_assigns[:alert].present? %>
    <div class="alert alert-danger py-2 text-13 mb-3"><%= alert %></div>
  <% elsif local_assigns[:notice].present? %>
    <div class="alert alert-success py-2 text-13 mb-3"><%= notice %></div>
  <% end %>

  <% if debug.present? %>
    <div class="sidebar-card mb-3 text-13">
      <div class="h-section-label">LiteLLM request</div>
      <dl class="detail-list text-12 mb-2">
        <dt>Model</dt><dd class="text-secondary"><code><%= debug.model %></code></dd>
        <dt>Endpoint</dt><dd class="text-secondary"><code><%= debug.endpoint %></code></dd>
      </dl>
      <details class="text-12 mb-2">
        <summary class="text-secondary">System prompt</summary>
        <pre class="font-monospace text-12 mt-2 mb-0 p-2 border rounded"><%= debug.system_prompt %></pre>
      </details>
      <details class="text-12 mb-2">
        <summary class="text-secondary">User message</summary>
        <pre class="font-monospace text-12 mt-2 mb-0 p-2 border rounded"><%= debug.user_message %></pre>
      </details>
      <details class="text-12 mb-0" <%= 'open' unless suggestion.present? %>>
        <summary class="text-secondary">Raw reply</summary>
        <% if debug.raw_reply.present? %>
          <pre class="font-monospace text-12 mt-2 mb-0 p-2 border rounded"><%= debug.raw_reply %></pre>
        <% else %>
          <p class="text-secondary mt-2 mb-0">No reply body was returned.</p>
        <% end %>
      </details>
    </div>
  <% end %>

  <% if suggestion.present? %>
    <div class="status-panel <%= suggestion.changes.any? { !it.placeholder_substitution? } ? 'status-attention' : 'status-clear' %> mb-3 text-13">
      <div class="fw-medium mb-1">Suggested changes</div>
      <% if suggestion.notes.present? %>
        <p class="text-secondary mb-2"><%= suggestion.notes %></p>
      <% end %>
      <% if suggestion.changes.empty? %>
        <p class="text-secondary mb-0">The model didn't change any values. Review the JSON below and edit by hand if needed.</p>
      <% else %>
        <ul class="list-compact mb-0">
          <% suggestion.changes.each do |change| %>
            <li class="<%= change.placeholder_substitution? ? 'text-secondary' : 'text-warning' %>">
              <span class="text-body"><%= change.node_id %></span>
              <%= change.node_label %>
              · <code><%= change.input %></code>:
              <span class="text-secondary"><%= truncate(change.from.to_s, length: 60) %></span>
              →
              <code><%= change.to %></code>
              <% unless change.placeholder_substitution? %>
                <span class="text-warning">(not a placeholder substitution)</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <p class="text-12 text-secondary mt-2 mb-0">Review the JSON below, then choose Save when it looks right.</p>
    </div>
  <% end %>
</div>
