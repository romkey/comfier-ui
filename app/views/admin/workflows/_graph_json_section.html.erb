<div id="workflow_graph_json_section" class="mb-3">
  <% field_id = 'workflow_graph_json' %>
  <% label = workflow.comfyui? ? 'Workflow (API format JSON)' : 'Recipe (JSON)' %>
  <% if form %>
    <%= form.label :graph_json, label, class: 'form-label', data: { engine_form_target: 'jsonLabel' } %>
    <%= form.text_area :graph_json, rows: 18, id: field_id, data: { engine_form_target: 'json' },
                       class: 'form-control form-control-sm font-monospace text-12', spellcheck: false %>
  <% else %>
    <%= label_tag field_id, label, class: 'form-label', data: { engine_form_target: 'jsonLabel' } %>
    <%= text_area_tag 'workflow[graph_json]', workflow.graph_json, rows: 18, id: field_id,
                      data: { engine_form_target: 'json' },
                      class: 'form-control form-control-sm font-monospace text-12', spellcheck: false %>
  <% end %>
  <div class="d-flex align-items-center gap-2 mt-2 flex-wrap <%= 'd-none' unless workflow.comfyui? %>"
       data-engine-form-target="comfyui">
    <%= button_tag type: 'submit', name: 'suggest_placeholders', value: '1',
                   formnovalidate: true, class: 'btn btn-outline-secondary btn-sm',
                   data: { turbo_submits_with: 'Suggesting…' } do %>
      <i class="bi bi-magic" aria-hidden="true"></i> Suggest placeholders
    <% end %>
    <% if LiteLlm::Client.configured? %>
      <span class="text-12 text-secondary">Built-in rules first, then LiteLLM
        (<code><%= ENV.fetch('LITELLM_MODEL') %></code>) for inputs they can't place.</span>
    <% else %>
      <span class="text-12 text-secondary">
        Uses built-in rules. Set <%= LiteLlm::Client.missing_config_keys.map { |key| tag.code(key) }.to_sentence %>
        in <code>.env</code> to have an LLM classify the rest.
      </span>
    <% end %>
  </div>
</div>
