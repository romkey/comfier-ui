<% content_for :title, 'Notifications' %>

<h1 class="h-page-title mb-3">Notifications</h1>
<p class="text-13 text-secondary mb-3">
  Email and Slack notifications are sent when a member's generation finishes, fails, or is cancelled.
</p>

<%= form_with model: @settings, url: admin_app_setting_path, method: :patch, class: 'settings-form-wide' do |f| %>
  <% if @settings.errors.any? %>
    <div class="alert alert-danger py-2 text-13"><%= @settings.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="h-section-label mb-2">Attachment limits</div>
  <p class="text-13 text-secondary mb-3">
    When a member opts to include the finished file, these caps apply separately to email and Slack.
    Decimals are allowed (for example, 0.5 for 512 KB). Set to 0 to always link instead of attach.
  </p>

  <div class="mb-3">
    <%= f.label :email_notification_attachment_max_mb, 'Email maximum (MB)', class: 'form-label' %>
    <%= f.number_field :email_notification_attachment_max_mb, min: 0, max: 100, step: 0.001,
                       class: 'form-control form-control-sm w-auto' %>
    <div class="form-text text-12">Default is about 500 KB (0.488 MB).</div>
  </div>

  <div class="mb-3">
    <%= f.label :slack_notification_attachment_max_mb, 'Slack maximum (MB)', class: 'form-label' %>
    <%= f.number_field :slack_notification_attachment_max_mb, min: 0, max: 100, step: 0.001,
                       class: 'form-control form-control-sm w-auto' %>
    <div class="form-text text-12">Files over each channel's limit are linked to Comfier instead of attached.</div>
  </div>

  <%= f.submit 'Save', class: 'btn btn-primary btn-sm' %>
<% end %>
