<div class="chat-sidebar">
  <div class="d-flex align-items-center justify-content-between mb-2">
    <h1 class="h-page-title mb-0">Chat</h1>
    <%= button_to chats_path, method: :post, class: 'btn btn-outline-secondary btn-sm' do %>
      <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New chat
    <% end %>
  </div>

  <% if @conversations.any? %>
    <ul class="list-compact chat-conversation-list mb-0">
      <% @conversations.each do |conversation| %>
        <li class="chat-conversation-row">
          <%= link_to chat_path(conversation),
                      class: ['chat-conversation-item', { active: @conversation&.id == conversation.id }] do %>
            <span class="text-truncate d-block text-13"><%= conversation.title_or_default %></span>
            <span class="text-12 text-secondary"><%= friendly_time(conversation.updated_at) %></span>
          <% end %>
          <%= button_to chat_path(conversation, return_to: @conversation&.id), method: :delete,
                        class: 'btn btn-link btn-sm text-secondary chat-conversation-delete',
                        title: 'Delete conversation', 'aria-label': "Delete #{conversation.title_or_default}",
                        form: { data: { turbo_confirm: 'Delete this conversation?' } } do %>
            <i class="bi bi-trash" aria-hidden="true"></i>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-13 text-secondary mb-0">No conversations yet.</p>
  <% end %>
</div>
